# Server Configuration
# PORT: Port to bind the Express scanner server (defaults to 3000)
PORT=3000

# NODE_ENV: Application environment ('production', 'development', or 'test')
NODE_ENV=production

# TRUST_PROXY: Set to 'true' or '1' when deployed behind a reverse proxy/load balancer
# to enable trusted X-Forwarded-For resolution for rate limiting. Defaults to false (direct socket IP).
TRUST_PROXY=false

# DISABLE_HMR: Set to 'true' in headless environments or AI Studio to disable Vite HMR/file-watching
DISABLE_HMR=false

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
